<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Headless LWC</masterLabel>
    <description>This is an LWC that doesn't include a real HTML UI. It's main use is for background processing</description>
    <targets>
        <target>lightning__RecordPage </target>
        <target>lightning__AppPage </target>
        <target>lightning__Tab</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
    <targetConfig targets="lightning__RecordPage">
        <objects>
            <object>Account</object>
             <object>Contact</object>
        </objects>
        <property name="message" type="String"
        default="Metadata XML File" 
        required ="true"
        label="Welcome Message"
        description="Welcome message to display"/>
        <property name="objectName" type="String"
         default="Account" 
        required ="true"
        label="Selected Object"
        description="Authorized object to display"/>
        <property name="showHeader" type="Boolean"
        default="true"
        label="ShowHeader"
        description="Display the component header."/>
        <property name="maxRecords" type="Integer"
        default="5" min="1" max ="100"
        label="Max Records"
        description="Maximum number of records to display"/>
    </targetConfig>
</targetConfigs>
</LightningComponentBundle>