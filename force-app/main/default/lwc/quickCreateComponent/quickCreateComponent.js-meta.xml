<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Quick Object Component</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
         <target>lightning__RecordPage</target>
        <target>lightning__UtilityBar</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightning__AppPage,lightning__UtilityBar,lightning__FlowScreen">
            <property name="objApiName" required="true" type="String" default="Case" label="Enter the Object API Name" description="This field will contain the object name"/>
            <property name="placeToBeUsed" type="String" default="Case Record Page" label="Provide the value where this component will be used." description="This will be helpful to identify which metaadata record to use " required="true"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
