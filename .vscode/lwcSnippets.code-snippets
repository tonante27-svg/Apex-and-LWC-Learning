	"Lightning Brand Button": {
    "prefix": "lwc:b",
    "body": [
        "<lightning-button",
        "    variant=\"brand\"",
        "    label=\"$1\"",
        "    title=\"$2\"",
        "    onclick={handleClick}>",
        "</lightning-button>"
    ],
    "description": "Create an LWC Lightning Brand Button"
	},
	"LWC Input": {
    "prefix": "lwc:input",
    "body": [
        "<lightning-input",
        "    type=\"$1\"",
        "    label=\"$2\"",
        "    name=\"$3\"",
        "    value={${4:value}}",
        "    onchange={handleChange}>",
        "</lightning-input>"
    ],
    "description": "LWC lightning-input"
	},
	"LWC Card": {
    "prefix": "lwc:card",
    "body": [
        "<lightning-card title=\"$1\" icon-name=\"$2\">",
        "    $3",
        "</lightning-card>"
    ],
    "description": "LWC lightning-card"
	},
	"LWC If": {
    "prefix": "lwc:if",
    "body": [
        "<template lwc:if={${1:condition}}>",
        "    $2",
        "</template>"
    ],
    "description": "LWC conditional rendering"
	},
	"LWC For Each": {
    "prefix": "lwc:for",
    "body": [
        "<template for:each={${1:items}} for:item=\"${2:item}\">",
        "    <div key={${2:item}.Id}>",
        "        $3",
        "    </div>",
        "</template>"
    ],
    "description": "LWC for:each loop"
	},
	"SLDS Spacing Wrapper": {
    "prefix": "slds:space",
    "body": [
        "<div class=\"slds-m-around_${1:medium}\">",
        "    $2",
        "</div>"
    ],
    "description": "SLDS margin wrapper"
	},
	"SLDS Grid": {
    "prefix": "slds:grid",
    "body": [
        "<div class=\"slds-grid slds-wrap\">",
        "    <div class=\"slds-col slds-size_1-of-2\">",
        "        $1",
        "    </div>",
        "    <div class=\"slds-col slds-size_1-of-2\">",
        "        $2",
        "    </div>",
        "</div>"
    ],
    "description": "SLDS two-column grid"
	},
	"LWC Icon": {
    "prefix": "lwc:icon",
    "body": [
        "<lightning-icon",
        "    icon-name=\"$1\"",
        "    alternative-text=\"$2\"",
        "    size=\"${3:small}\">",
        "</lightning-icon>"
    ],
    "description": "LWC lightning-icon"
	},
	"LWC Spinner": {
    "prefix": "lwc:spinner",
    "body": [
        "<template lwc:if={${1:isLoading}}>",
        "    <lightning-spinner",
        "        alternative-text=\"${2:Loading}\"",
        "        size=\"${3:medium}\">",
        "    </lightning-spinner>",
        "</template>"
    ],
    "description": "LWC loading spinner"
	},
	"SLDS Center": {
    "prefix": "slds:center",
    "body": [
        "<div class=\"slds-grid slds-grid_align-center\">",
        "    $1",
        "</div>"
    ],
    "description": "Center content using SLDS"
	}
}